entrypoints Program;
AProgram. Program ::= "language" "core" ";" [Extension] [Decl];
AExtension. Extension ::= "extend" "with" [ExtensionName] ";";
token ExtensionName '#' (letter | digit | '-' | '_')+;
separator nonempty ExtensionName ",";
terminator Extension "";
DeclFun. Decl ::= "fn" Name "(" Param ")" "->" Type "{" "return" Expr "}";
terminator Decl "";
AParam. Param ::= Name ":" Type;
token Name (letter | '_') (letter | digit | '_' | '\'')* ((':' ':') (letter | digit | '_')+)*;
TypeFun. Type ::= "fn" "(" Type ")" "->" Type;
TypeSum. Type ::= Type1 "+" Type;
TypeBool. Type1 ::= "Bool";
TypeNat. Type1 ::= "Nat";
TypeUnit. Type1 ::= "Unit";
TypeTuple. Type1 ::= "{" [Type] "}";
TypeRecord. Type1 ::= "{" [FieldType] "}";
TypeVariant. Type1 ::= "<|" [FieldType] "|>";
TypeList. Type1 ::= "[" Type "]";
_. Type1 ::= "(" Type ")";
_. Type ::= Type1;
AFieldType. FieldType ::= Name ":" Type;
separator nonempty FieldType ",";
separator Type ",";
If. Expr ::= "if" Expr "then" Expr "else" Expr;
Let. Expr ::= "let" [Binding] "in" Expr;
Abstraction. Expr ::= "fn" "(" Param ")" "{" "return" Expr "}";
Match. Expr ::= "match" Expr "{" [Case] "}";
TypeAsc. Expr1 ::= Expr1 "as" Type;
Application. Expr2 ::= Expr2 "(" Expr ")";
DotTuple. Expr2 ::= Expr2 "." Integer;
DotRecord. Expr2 ::= Expr2 "." Name;
ConstTrue. Expr3 ::= "true";
ConstFalse. Expr3 ::= "false";
ConstUnit. Expr3 ::= "unit";
ConstInt. Expr3 ::= Integer;
Var. Expr3 ::= Name;
Tuple. Expr3 ::= "{" [Expr] "}";
Record. Expr3 ::= "{" [Field] "}";
List. Expr3 ::= "[" [Expr] "]";
Variant. Expr3 ::= "<|" Name "=" Expr "|>";
Inl. Expr3 ::= "inl" "(" Expr ")";
Inr. Expr3 ::= "inr" "(" Expr ")";
Succ. Expr3 ::= "succ" "(" Expr ")";
Pred. Expr3 ::= "Nat::pred" "(" Expr ")";
IsZero. Expr3 ::= "Nat::iszero" "(" Expr ")";
NatRec. Expr3 ::= "Nat::rec" "(" Expr "," Expr "," Expr ")";
ConsList. Expr3 ::= "cons" "(" Expr "," Expr ")";
Head. Expr3 ::= "List::head" "(" Expr ")";
Tail. Expr3 ::= "List::tail" "(" Expr ")";
IsEmpty. Expr3 ::= "List::isempty" "(" Expr ")";
Fix. Expr3 ::= "fix" "(" Expr ")";
coercions Expr 3;
AField. Field ::= Name "=" Expr;
separator nonempty Field ",";
separator Expr ",";
ABinding. Binding ::= Pattern "=" Expr;
separator nonempty Binding ",";
ACase. Case ::= Pattern "=>" Expr;
separator Case "|";
PatternVar. Pattern ::= Name;
PatternInl. Pattern ::= "inl" "(" Pattern ")";
PatternInr. Pattern ::= "inr" "(" Pattern ")";
PatternVariant. Pattern ::= "<|" Name "=" Pattern "|>";
comment "//";
comment "/*" "*/";
